# Sao chép file này thành ".env" rồi điền key sau dấu "=" (không dấu ngoặc, không khoảng trắng).
# File ".env" đã nằm trong .gitignore. KHÔNG gửi key qua chat/email/commit.
CRYPTOCOMPARE_API_KEY=
# Không bắt buộc: có key Dune thì run_all.bat / fetch_onchain tự tải dữ liệu on-chain (dune.com -> Settings -> API)
DUNE_API_KEY=
